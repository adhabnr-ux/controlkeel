#!/bin/bash
# Git Pre-Commit Hook: ControlKeel Governance Enforcement
# This hook enforces governance protocols before allowing commits

set -e

# Run the governance check script
if [ -f ".governance-check.sh" ]; then
    ./.governance-check.sh
fi

# Check if governance state file exists
if [ ! -f ".ck-session-governed" ]; then
    echo "❌ GOVERNANCE ERROR: Cannot commit without governance state"
    echo ""
    echo "Before committing, you must:"
    echo "  1. Call ck_context to load session state"
    echo "  2. Invoke controlkeel-governance skill"
    echo "  3. Create .ck-session-governed file after governance setup"
    echo ""
    echo "To bypass (NOT RECOMMENDED): touch .ck-session-governed"
    exit 1
fi

echo "✅ Governance pre-commit check passed"