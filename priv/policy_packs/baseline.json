[
  {
    "id": "secret.aws_access_key",
    "category": "security",
    "severity": "critical",
    "action": "block",
    "plain_message": "We found what looks like a hardcoded AWS access key. Move it into an environment variable or secret manager before continuing.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "AKIA[0-9A-Z]{16}"
      ]
    }
  },
  {
    "id": "secret.hardcoded_credential",
    "category": "security",
    "severity": "high",
    "action": "block",
    "plain_message": "This looks like a hardcoded credential. Keep credentials out of source and pass them in through environment variables or a secrets manager.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?i)(api[_-]?key|secret[_-]?key|secret|token|password|master[_-]?password|database[_-]?url)\\s*[:=]\\s*[\"'][^\"'\\n]{6,}[\"']",
        "(?i)@(api_key|secret_key|master_password|admin_password|auth_token|access_token|private_key)\\s+[\"'][^\"'\\n]{6,}[\"']"
      ]
    }
  },
  {
    "id": "secret.high_entropy_token",
    "category": "security",
    "severity": "high",
    "action": "block",
    "plain_message": "We found a secret-like token in plain text. Replace it with a reference to a secure secret store before execution continues.",
    "matcher": {
      "type": "entropy",
      "candidate_pattern": "[A-Za-z0-9_\\-=/+]{20,}",
      "min_length": 20,
      "threshold": 3.5
    }
  },
  {
    "id": "security.sql_injection",
    "category": "security",
    "severity": "critical",
    "action": "block",
    "plain_message": "This content looks like SQL built directly from user input. Switch to parameterized queries before the agent keeps going.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?i)(['\"])\\s*or\\s*1=1",
        "(?i)union\\s+select",
        "(?i)drop\\s+table",
        "(?i)select\\s+.+\\s+from\\s+.+(\\+|#\\{|\\$\\{|<>|\\|\\|)"
      ]
    }
  },
  {
    "id": "security.code_execution",
    "category": "security",
    "severity": "critical",
    "action": "block",
    "plain_message": "This calls a dynamic code-execution sink (eval/exec/os.system/shell=True). Untrusted input reaching it is remote code execution. Use a safe parser or an allow-listed dispatch instead of executing the input.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?<![.\\w])eval\\s*\\(",
        "(?<![.\\w])exec\\s*\\(",
        "\\bos\\.system\\s*\\(",
        "\\bsubprocess\\.(?:call|run|Popen|check_output)\\s*\\([^)]*shell\\s*=\\s*True",
        "(?<![.\\w])(?:Function|setTimeout|setInterval)\\s*\\(\\s*[\"'`][^\"'`]*\\$\\{"
      ]
    }
  },
  {
    "id": "security.xss_unsafe_html",
    "category": "security",
    "severity": "high",
    "action": "block",
    "plain_message": "This content writes raw HTML into the page. Prefer safer rendering paths before shipping it.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?i)<script\\b",
        "(?i)innerHTML\\s*=",
        "(?i)dangerouslySetInnerHTML"
      ]
    }
  },
  {
    "id": "security.open_redirect",
    "category": "security",
    "severity": "high",
    "action": "block",
    "plain_message": "Redirect destination is controlled by user input. An attacker can redirect users to a malicious site. Validate the redirect target against an allowlist.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?i)(redirect|location\\s*[=:]).{0,80}(params\\[|request\\.(args|form|query|body)|req\\.(query|body|params)|conn\\.params)",
        "(?i)redirect\\(conn,\\s*(to:|external:)\\s*(params|conn\\.params)"
      ]
    }
  },
  {
    "id": "security.unsafe_deserialization",
    "category": "security",
    "severity": "critical",
    "action": "block",
    "plain_message": "Deserializing untrusted data can lead to remote code execution. Use a safe format like JSON and never pass user-controlled input to pickle, Marshal, or unserialize.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?i)pickle\\.loads\\s*\\(",
        "(?i)marshal\\.load\\s*\\(",
        "(?i)yaml\\.load\\s*\\((?!.*Loader\\s*=\\s*yaml\\.SafeLoader)",
        "(?i)\\bunserialize\\s*\\(",
        "(?i)Marshal\\.load\\s*\\("
      ]
    }
  },
  {
    "id": "security.jwt_none_algorithm",
    "category": "security",
    "severity": "critical",
    "action": "block",
    "plain_message": "JWT 'none' algorithm disables signature verification and allows token forgery. Always enforce a specific signing algorithm and reject tokens that specify 'none'.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?i)[\"']alg[\"']\\s*(?:[:,]|=>)\\s*[\"']none[\"']",
        "(?i)(algorithm|alg)\\s*(?:[=:]|=>)\\s*[\"']none[\"']",
        "(?i)algorithms\\s*=\\s*\\[.*[\"']none[\"']"
      ]
    }
  },
  {
    "id": "security.plaintext_password_storage",
    "category": "security",
    "severity": "critical",
    "action": "block",
    "plain_message": "Passwords must be hashed with a strong KDF (bcrypt, argon2, pbkdf2) before storage. Never store or persist plaintext passwords.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?i)field\\s*\\(?\\s*:(password|password_hash|passwd)\\s*,\\s*:string",
        "(?i)(user\\.password|account\\.password)\\s*=\\s*(?!.*hash|.*bcrypt|.*argon|.*scrypt|.*pbkdf)"
      ]
    }
  },
  {
    "id": "security.file_upload_no_validation",
    "category": "security",
    "severity": "high",
    "action": "warn",
    "plain_message": "File uploads must validate content type and file extension before writing to disk. Unrestricted uploads can lead to stored XSS or code execution.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?i)(File\\.cp!|File\\.write!|shutil\\.copy|move_uploaded_file).{0,100}(upload|tmp_path|filename)",
        "(?i)\\bPlug\\.Upload\\b"
      ]
    }
  },
  {
    "id": "security.env_dump_leak",
    "category": "security",
    "severity": "high",
    "action": "block",
    "plain_message": "Dumping all environment variables exposes every secret to logs or responses. Access only the specific variables your code needs.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "System\\.get_env\\(\\)",
        "(?i)(os\\.environ\\.copy\\(\\)|os\\.environ\\.items\\(\\)|ENV\\.to_h\\b)"
      ]
    }
  },
  {
    "id": "security.mass_assignment",
    "category": "security",
    "severity": "critical",
    "action": "block",
    "plain_message": "Protected fields such as user_id, role, status, discounts, or refunds must not be mass-assigned from user params. Set them explicitly from trusted server context.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?is)cast\\s*\\([^\\)]*,\\s*\\[[^\\]]*:(?:user_id|role|admin|is_admin|status|discount_percent|refunded_amount)[^\\]]*\\]",
        "(?is)permit\\s*\\([^\\)]*(?:user_id|role|admin|is_admin|status|discount_percent|refunded_amount)"
      ]
    }
  },
  {
    "id": "quality.bare_except",
    "category": "quality",
    "severity": "medium",
    "action": "warn",
    "plain_message": "Bare except clauses catch all exceptions including system-exiting ones like KeyboardInterrupt. Use specific exception types.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "except\\s*:"
      ]
    }
  },
  {
    "id": "quality.go_ignored_error",
    "category": "quality",
    "severity": "medium",
    "action": "warn",
    "plain_message": "Discarding a return value with _ in Go can silently hide errors. Check that the discarded value is not an error.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "_\\s*=\\s*\\w+\\(",
        "[^,]+,\\s*_\\s*:?=\\s*\\w+\\("
      ]
    }
  },
  {
    "id": "quality.python_unpinned_dependency",
    "category": "quality",
    "severity": "medium",
    "action": "warn",
    "plain_message": "Unpinned dependencies (>=, >, or no version) can cause unexpected breaking changes. Use exact version pinning (==) or compatible version ranges (~=) for stability.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?i)^[a-z][a-z0-9_-]+(\\[[^\\]]*\\])?\\s*(>=|>)",
        "(?i)^[a-z][a-z0-9_-]+(\\[[^\\]]*\\])?\\s*$"
      ]
    }
  },
  {
    "id": "quality.js_unpinned_dependency",
    "category": "quality",
    "severity": "medium",
    "action": "warn",
    "plain_message": "Unpinned JavaScript dependencies (* or latest) can cause unexpected breaking changes. Use exact versions or tight ranges for stability.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "\"[^\"]+\"\\s*:\\s*\"\\*\"",
        "\"[^\"]+\"\\s*:\\s*\"latest\"",
        "\"[^\"]+\"\\s*:\\s*\">[0-9]",
        "\"[^\"]+\"\\s*:\\s*\">=[0-9]"
      ]
    }
  },
  {
    "id": "quality.ts_no_strict_mode",
    "category": "quality",
    "severity": "medium",
    "action": "warn",
    "plain_message": "TypeScript strict mode is disabled. Set strict: true in tsconfig.json to catch type errors early and improve code quality.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "\"strict\"\\s*:\\s*(false|null)"
      ]
    }
  },
  {
    "id": "quality.ts_any_type",
    "category": "quality",
    "severity": "low",
    "action": "warn",
    "plain_message": "Using the 'any' type defeats TypeScript's type checking. Use specific types or 'unknown' with type guards for better type safety.",
    "matcher": {
      "type": "regex",
      "patterns": [
        ":\\s*any\\b"
      ]
    }
  },
  {
    "id": "quality.retry_without_limit",
    "category": "quality",
    "severity": "medium",
    "action": "warn",
    "plain_message": "Retry decorator without an explicit stop condition may cause infinite retries. Add stop_after_attempt, max_tries, or equivalent.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "@retry\\((?!.*(stop|max|retries|attempts))",
        "@backoff\\.(?!.*max)"
      ]
    }
  },
  {
    "id": "secret.ai_tool_config_key",
    "category": "security",
    "severity": "high",
    "action": "block",
    "plain_message": "AI tool configuration contains hardcoded credentials. Move to environment variables or secret managers.",
    "matcher": {
      "type": "regex",
      "patterns": [
        "(?i)(factory|cursor|warp|copilot|codeium|droid)_api_key\\s*[:=]\\s*[\"'][^\"']{20,}[\"']",
        "(?i)(factory|cursor|warp|copilot|codeium|droid)_secret\\s*[:=]\\s*[\"'][^\"']{20,}[\"']"
      ]
    }
  }
]
