#!/usr/bin/env bash
set -e

# If we are in the source tree, forward to mix tasks or Elixir script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$ROOT_DIR"

CMD="$1"
if [ -z "$CMD" ]; then
  mix run -e 'ControlKeel.CLI.parse(["--help"]) |> elem(1) |> ControlKeel.CLI.run_command(File.cwd!()) |> elem(1) |> Enum.each(&IO.puts/1)'
  exit 0
fi

if [ "$CMD" = "context" ]; then
  shift
  mix ck.context "$@"
elif [ "$CMD" = "validate" ]; then
  shift
  mix ck.validate "$@"
elif [ "$CMD" = "finding" ]; then
  shift
  mix ck.findings "$@"
else
  # Generic fallback to Elixir script execution if task doesn't exist
  # This is a source-checkout wrapper, so we can use `mix run`
  mix run -e "ControlKeel.CLI.parse(System.argv()) |> case do {:ok, p} -> ControlKeel.CLI.run_command(p, File.cwd!()) |> case do {:ok, lines} -> Enum.each(lines, &IO.puts/1); {:error, msg} -> IO.puts(:stderr, msg); System.halt(1) end; {:error, msg} -> IO.puts(:stderr, msg); System.halt(1) end" -- "$@"
fi
