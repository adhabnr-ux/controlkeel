#!/usr/bin/env bash
set -e

# If we are in the source tree, forward to mix tasks or Elixir script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$ROOT_DIR"

CMD="$1"
if [ -z "$CMD" ]; then
  mix run -e 'ControlKeel.CLI.parse(["--help"]) |> elem(1) |> ControlKeel.CLI.run_command(File.cwd!()) |> elem(1) |> Enum.each(&IO.puts/1)'
  exit 0
fi

if [ "$CMD" = "context" ]; then
  shift
  mix ck.context "$@"
elif [ "$CMD" = "validate" ]; then
  shift
  mix ck.validate "$@"
elif [ "$CMD" = "finding" ]; then
  shift
  mix ck.findings "$@"
else
  # Use execute/1 (not run_command/2) to ensure the JSON success envelope
  # interceptor applies for --json and --format json output.
  mix run -e '
    case ControlKeel.CLI.parse(System.argv()) do
      {:ok, parsed} ->
        System.halt(ControlKeel.CLI.execute(parsed, []))

      {:error, message} ->
        IO.puts(:stderr, message)
        System.halt(1)
    end
  ' -- "$@"
fi
