# ControlKeel environment example
# IMPORTANT: never commit real secrets. Copy this file to `.env` for local use,
# and use platform-managed secrets for production/cloud deployments.
#
# Two runtime modes are supported:
#   - local  (default): SQLite, no external services required.
#   - cloud         : Postgres via DATABASE_URL; set CONTROLKEEL_RUNTIME_MODE=cloud.

# --- Application ---
PHX_HOST=localhost
PORT=4000
SECRET_KEY_BASE=CHANGE_ME_GENERATE_WITH_mix_phx.gen.secret

# --- Local storage (CONTROLKEEL_RUNTIME_MODE=local) ---
# SQLite is used locally unless CONTROLKEEL_RUNTIME_MODE=cloud is set.
DATABASE_PATH=./controlkeel_dev.db
POOL_SIZE=10

# --- Cloud storage (CONTROLKEEL_RUNTIME_MODE=cloud) ---
# Uncomment for cloud/docker deployments.
# CONTROLKEEL_RUNTIME_MODE=cloud
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# ECTO_USE_SSL=true

# --- MCP runtime ---
# CK_MCP_MODE=1 enables the MCP server; leave unset or 0 to disable.
CK_MCP_MODE=0

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- GitHub OAuth ---
GITHUB_OAUTH_CLIENT_ID=CHANGE_ME
GITHUB_OAUTH_CLIENT_SECRET=CHANGE_ME
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/auth/github/callback
